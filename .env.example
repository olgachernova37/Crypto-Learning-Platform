# Solana RPC used by the in-browser training wallet. Defaults to public devnet.
# Public devnet's faucet is rate-limited; a free Helius/QuickNode devnet URL is more reliable.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Optional: enables the "Ask AI" helper (server-side only, never exposed to the browser).
ANTHROPIC_API_KEY=
