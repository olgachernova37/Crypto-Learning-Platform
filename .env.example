# Solana RPC used by the in-browser training wallet. Defaults to public devnet.
# Public devnet's faucet is rate-limited; a free Helius/QuickNode devnet URL is more reliable.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# AI guide in lessons (Google Gemini). SERVER-SIDE ONLY: never prefix with NEXT_PUBLIC_,
# never commit a real value. Set it in Vercel → Project → Settings → Environment Variables.
# Without it, "Ask AI" still works with hints from the lesson notes.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=

# Admin page (/admin, "Captain's deck") with demo shortcuts. SERVER-SIDE ONLY, choose a long password.
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin cookie (defaults to the password).
# ADMIN_SECRET=

# Optional: list of registered learners on /admin. Connect Upstash Redis in Vercel
# (Storage → Marketplace → Upstash); Vercel then adds these two automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
